  "components": {
    "schemas": {
      "MensagemRequest": {
        "required": [
          "mensagem",
          "whatsapp"
        ],
        "type": "object",
        "properties": {
          "whatsapp": {
            "type": "string",
            "description": "Número do WhatsApp para envio",
            "example": "5511987654321"
          },
          "mensagem": {
            "type": "string",
            "description": "Conteúdo da mensagem a ser enviada",
            "example": "Olá, esta é uma mensagem de teste!"
          }
        },
        "description": "Informações para envio de mensagem via WhatsApp"
      },
      "ErrorApiResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Mensagem de erro detalhada",
            "example": "Por favor, verifique os dados fornecidos e tente novamente."
          },
          "description": {
            "type": "string",
            "description": "Descrição do erro",
            "example": "Erro na solicitação"
