  "paths": {
    "/whatsapp-message/envia": {
      "post": {
        "tags": [
          "ComunicacaoAPI"
        ],
        "summary": "Envia uma mensagem pelo WhatsApp",
        "description": "Este método permite enviar uma mensagem utilizando um número de WhatsApp válido",
        "operationId": "postMensagem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MensagemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Erro de validação nos campos de entrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                },
                "example": {
                  "whatsapp": "O número do WhatsApp não pode estar vazio",
                  "mensagem": "A mensagem não pode estar vazia"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL SERVER ERROR",
            "content": {
              "application/json": {
                "example": {
                  "description": "INTERNAL SERVER ERROR!",
                  "message": "POR FAVOR INFORME AO ADMINISTRADOR DO SISTEMA!"
                }
              }
            }
          },
          "204": {
            "description": "Mensagem enviada com sucesso"
          }
        }
      }
    },
    "/wakander/novo-wakander": {
      "post": {
        "tags": [
          "WakanderAPI"
        ],
        "summary": "Cria um novo Wakander",
        "description": "Este método permite criar um novo Wakander no sistema",
        "operationId": "postNovoWakander",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WakanderNovoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Erro de validação nos campos de entrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                },
                "example": {
                  "nome": "O nome não pode estar vazio.",
                  "cpf": "O CPF informado é inválido.",
                  "message": "O CPF deve ter 11 dígitos numéricos, sem espaços, pontos ou hífen, apenas os números.",
                  "idMemberKit": "O ID do Kit de Membro não pode estar vazio.",
                  "whatsapp": "O número de WhatsApp deve ter entre 13 e 15 dígitos numéricos, sem espaços, hífen ou sinal de mais, apenas os números.",
                  "email": "O email não pode estar vazio.",
                  "IdPaymentAsaas": "O Payment ID do Asaas não pode estar vazio.",
                  "idAsaasFiador": "O ID do fiador no Asaas não pode estar vazio.",
                  "idAssinaturaFiador": "O ID da assinatura do fiador no Asaas não pode estar vazio.",
                  "nomeFiador": "O nome do fiador não pode estar vazio.",
                  "cpfFiador": "O CPF do fiador informado é inválido.",
                  "telefoneFiador": "O número de telefone do fiador não pode estar vazio."
                }
              }
            }
          },
          "409": {
            "description": "Existem dados duplicados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApiResponse"
                },
                "example": {
                  "message": "Existem dados duplicados"
                }
              }
            }
          },
          "201": {
            "description": "Wakander criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WakanderCriadoResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL SERVER ERROR",
            "content": {
              "application/json": {
                "example": {
                  "description": "INTERNAL SERVER ERROR!",
                  "message": "POR FAVOR INFORME AO ADMINISTRADOR DO SISTEMA!"
                }
              }
            }
          }
        }
      }
    },
